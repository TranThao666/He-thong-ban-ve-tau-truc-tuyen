@{
    ViewData["Title"] = "Quản lý tuyến và chuyến tàu";
    var stations = (IReadOnlyList<Station>)ViewBag.Stations;
    var routes = (IReadOnlyList<RailRoute>)ViewBag.Routes;
    var trips = (IReadOnlyList<TrainTrip>)ViewBag.Trips;
}
<section class="section-block admin-content"><div class="section-heading"><div><span class="eyebrow">DỮ LIỆU VẬN HÀNH</span><h1>Tuyến & chuyến tàu</h1><p class="muted">Tạo tuyến đường và lịch chạy từ dữ liệu nhà ga.</p></div></div>
<div class="admin-form-grid"><form asp-action="CreateRoute" method="post" class="panel form-panel" data-ajax-check>@Html.AntiForgeryToken()<h2>Thêm tuyến đường</h2><label>Tên tuyến<input name="Name" required placeholder="Hà Nội - Đà Nẵng"/></label><label>Ga đi<select name="StartStationId" required><option value="">Chọn ga đi</option>@foreach(var station in stations){<option value="@station.Id">@station.Name</option>}</select></label><label>Ga đến<select name="EndStationId" required><option value="">Chọn ga đến</option>@foreach(var station in stations){<option value="@station.Id">@station.Name</option>}</select></label><label>Khoảng cách (km)<input type="number" name="DistanceKm" min="1" required/></label><button class="button">Tạo tuyến</button></form>
<form asp-action="CreateTrip" method="post" class="panel form-panel" data-ajax-check>@Html.AntiForgeryToken()<h2>Thêm chuyến tàu</h2><label>Mã tàu<input name="TrainCode" required placeholder="SE7"/></label><label>Tuyến<select name="RouteId" required><option value="">Chọn tuyến</option>@foreach(var route in routes){<option value="@route.Id">@route.Name</option>}</select></label><div class="form-row"><div><label>Khởi hành<input type="datetime-local" name="Departure" required/></label></div><div><label>Đến nơi<input type="datetime-local" name="Arrival" required/></label></div></div><div class="form-row"><div><label>Giá vé<input type="number" name="Fare" min="1" required/></label></div><div><label>Tổng số ghế<input type="number" name="SeatCount" min="1" value="40" required/></label></div></div><button class="button">Tạo chuyến & sơ đồ ghế</button></form></div>
<div class="panel table-panel"><div class="section-heading"><h2>Danh sách tuyến</h2><span class="result-count">@routes.Count tuyến</span></div><div class="table-wrap"><table><thead><tr><th>Tên tuyến</th><th>Ga đi</th><th>Ga đến</th><th>Khoảng cách</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var route in routes){<tr><td><b>@route.Name</b></td><td>@route.StartStation?.Name</td><td>@route.EndStation?.Name</td><td>@route.DistanceKm km</td><td><span class="status-pill status-paid">Đang hoạt động</span></td></tr>}</tbody></table></div></div>
<div class="panel table-panel"><div class="section-heading"><h2>Lịch chạy tàu</h2><span class="result-count">@trips.Count chuyến</span></div><div class="table-wrap"><table><thead><tr><th>Mã tàu</th><th>Tuyến</th><th>Khởi hành</th><th>Đến</th><th>Giá</th><th>Ghế trống</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var trip in trips){<tr><td><b>@trip.TrainCode</b></td><td>@trip.Route?.Name</td><td>@trip.Departure.ToString("dd/MM/yy HH:mm")</td><td>@trip.Arrival.ToString("dd/MM/yy HH:mm")</td><td>@trip.BaseFare.ToString("N0") đ</td><td>@trip.AvailableSeats / @trip.SeatCount</td><td><span class="status-pill status-paid">@trip.Status</span></td></tr>}</tbody></table></div></div>
</section>

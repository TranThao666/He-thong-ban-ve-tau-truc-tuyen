<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Vé Tàu Việt</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brand.css" asp-append-version="true" />
</head>
<body>
    @if (User.IsInRole("Admin"))
    {
        <aside class="admin-sidebar">
            <a class="brand brand-light" asp-controller="Admin" asp-action="Dashboard"><img class="brand-mark" src="/images/logo.svg" alt="" /><span>Vé Tàu Việt<small>Quản trị hệ thống</small></span></a>
            <nav class="side-nav">
                <a asp-controller="Admin" asp-action="Dashboard">▦ &nbsp; Tổng quan & Báo cáo</a>
                <a asp-controller="Admin" asp-action="RoutesAndTrips">⌁ &nbsp; Nhà ga, tuyến & chuyến</a>
                <a asp-controller="Staff" asp-action="Lookup">▣ &nbsp; Soát vé & tra cứu</a>
                <a asp-controller="Staff" asp-action="CounterSale">🎫 &nbsp; Bán vé tại quầy</a>
                <a asp-controller="Admin" asp-action="Users">♙ &nbsp; Quản lý người dùng</a>
                <a asp-controller="Booking" asp-action="MyTickets">▤ &nbsp; Vé của tôi</a>
            </nav>
            <div class="side-note"><strong>Vé Tàu Việt</strong><span>Hệ thống quản lý vận hành</span></div>
        </aside>
    }
    <div class="app-shell @(User.IsInRole("Admin") ? "with-sidebar" : "")">
        @if (ViewData["HideFooter"] is not true)
        {
        <header class="topbar">
            <a class="brand" asp-controller="Home" asp-action="Index"><img class="brand-mark" src="/images/logo.svg" alt="" /><span>Vé Tàu Việt</span></a>
            <nav class="main-nav">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                    <a asp-controller="Booking" asp-action="MyTickets">Vé của tôi</a>
                    @if (User.IsInRole("NhanVien"))
                    {
                        <a asp-controller="Staff" asp-action="Lookup">Soát vé & tra cứu</a>
                        <a asp-controller="Staff" asp-action="CounterSale">Bán vé tại quầy</a>
                    }
                    <a asp-controller="Account" asp-action="Profile">Hồ sơ</a>
                    <span class="user-chip"><span class="avatar">@User.Identity.Name?.FirstOrDefault()</span>@User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button class="nav-logout">Đăng xuất</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login">Đăng nhập</a>
                    <a class="button button-small" asp-controller="Account" asp-action="Register">Tạo tài khoản</a>
                }
            </nav>
        </header>
        }
        <main class="main-content">
            @if (TempData["Success"] is string success) { <div class="flash flash-success">@success</div> }
            @if (TempData["Error"] is string error) { <div class="flash flash-error">@error</div> }
            @RenderBody()
        </main>
        @if (ViewData["HideFooter"] is not true) { <footer class="footer"><span>© 2026 Vé Tàu Việt</span><span>Đồng hành trên mọi hành trình</span></footer> }
    </div>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
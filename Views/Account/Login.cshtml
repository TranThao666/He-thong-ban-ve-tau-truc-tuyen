@model LoginInput
@{
    ViewData["Title"] = "Đăng nhập";
    ViewData["HideFooter"] = true;
}
<section class="auth-page">
    <div class="auth-photo auth-photo-login">
        <a class="brand brand-photo" asp-controller="Home" asp-action="Index"><img class="brand-mark" src="/images/logo.svg" alt="" /><span>Vé Tàu Việt</span></a>
        <div class="auth-photo-copy"><span class="eyebrow eyebrow-light">KHÁM PHÁ · TRẢI NGHIỆM · KẾT NỐI</span><h1>Mỗi chuyến tàu,<br />một câu chuyện đáng nhớ.</h1><p>Đưa bạn đến những miền đất mới trên hành trình an tâm và trọn vẹn.</p></div>
    </div>
    <div class="auth-panel">
        <div class="auth-content">
            <span class="eyebrow">CHÀO MỪNG TRỞ LẠI</span><h2>Đăng nhập</h2><p class="muted">Đăng nhập để tiếp tục hành trình của bạn.</p>
            @if (TempData["Success"] is string success) { <div class="flash flash-success">@success</div> }
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <form asp-action="Login" method="post" data-ajax-check>
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                <label>Email<input asp-for="Email" type="email" placeholder="name@email.com" autocomplete="email" required /></label><span asp-validation-for="Email" class="field-error"></span>
                <label>Mật khẩu<input asp-for="Password" type="password" placeholder="Nhập mật khẩu" autocomplete="current-password" required /></label><span asp-validation-for="Password" class="field-error"></span>
                <div class="form-between"><label class="check-line"><input type="checkbox" /> Ghi nhớ đăng nhập</label><a href="#" class="text-link">Quên mật khẩu?</a></div>
                <button class="button button-block">Đăng nhập</button>
            </form>
            <p class="auth-switch">Chưa có tài khoản? <a asp-action="Register">Đăng ký ngay</a></p>
        </div>
    </div>
</section>


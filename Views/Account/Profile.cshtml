@model DbUser
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}
<section class="section-block">
    <div class="section-heading">
        <div>
            <span class="eyebrow">TÀI KHOẢN CỦA BẠN</span>
            <h1>Hồ sơ cá nhân</h1>
            <p class="muted">Cập nhật thông tin liên hệ và bảo mật mật khẩu.</p>
        </div>
    </div>
    <div class="profile-layout">
        <aside class="panel profile-card">
            <div class="profile-avatar">@Model.Name.FirstOrDefault()</div>
            <h3>@Model.Name</h3>
            <p>@Model.Email</p>
            <span class="status-pill status-paid">@Model.Role</span>
        </aside>

        <div style="display:flex; flex-direction:column; gap:1.5rem;">
            <form class="panel form-panel" asp-action="UpdateProfile" method="post" data-ajax-check>
                @Html.AntiForgeryToken()
                <h2>Thông tin cá nhân</h2>
                <label>Họ và tên<input name="name" value="@Model.Name" required /></label>
                <label>Email<input value="@Model.Email" readonly /></label>
                <label>Số điện thoại<input name="phone" value="@Model.Phone" required /></label>
                <label>Số CCCD<input name="cccd" value="@Model.Cccd" required /></label>
                <button class="button">Lưu thay đổi</button>
            </form>

            <form class="panel form-panel" asp-action="ChangePassword" method="post">
                @Html.AntiForgeryToken()
                <h2>Đổi mật khẩu</h2>
                <label>Mật khẩu hiện tại<input type="password" name="CurrentPassword" required /></label>
                <label>Mật khẩu mới (tối thiểu 6 ký tự)<input type="password" name="NewPassword" minlength="6" required /></label>
                <label>Xác nhận mật khẩu mới<input type="password" name="ConfirmPassword" minlength="6" required /></label>
                <button class="button button-outline">Cập nhật mật khẩu</button>
            </form>
        </div>
    </div>
</section>
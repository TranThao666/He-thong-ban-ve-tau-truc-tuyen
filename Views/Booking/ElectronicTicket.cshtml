@model TrainTicket
@{
    ViewData["Title"] = "Vé điện tử";
    var trip = Model.Trip!;
}
<section class="booking-progress"><span class="active">01 <b>Chọn chuyến</b></span><i></i><span class="active">02 <b>Chọn ghế</b></span><i></i><span class="active">03 <b>Hành khách</b></span><i></i><span class="active">04 <b>Thanh toán</b></span><i></i><span class="active">05 <b>Hoàn tất</b></span></section>
<section class="section-block ticket-success"><div class="success-badge">✓</div><span class="eyebrow">ĐẶT VÉ THÀNH CÔNG</span><h1>Vé điện tử của bạn</h1><p class="muted">Mã vé <b>@Model.Code</b> · Thanh toán thành công</p>
<article class="e-ticket"><div class="e-ticket-main"><img src="~/images/trains/train-1.jpg" alt="Khung cảnh hành trình tàu"/><div class="ticket-overlay"><span>@trip.TrainCode · @trip.Route?.Name</span><h2>@trip.Route?.StartStation?.Name <i>→</i> @trip.Route?.EndStation?.Name</h2></div><div class="ticket-times"><div><strong>@trip.Departure.ToString("HH:mm")</strong><span>@trip.Route?.StartStation?.Name</span><small>@trip.Departure.ToString("dd/MM/yyyy")</small></div><i></i><div><strong>@trip.Arrival.ToString("HH:mm")</strong><span>@trip.Route?.EndStation?.Name</span><small>@trip.Arrival.ToString("dd/MM/yyyy")</small></div></div><div class="ticket-details"><span>Hành khách <b>@Model.PassengerName</b></span><span>CCCD <b>@Model.PassengerCccd</b></span><span>Toa / ghế <b>@Model.Seat?.Car?.Number / @Model.Seat?.Number</b></span><span>Giá vé <b>@Model.Fare.ToString("N0") đ</b></span></div><small class="ticket-code">MÃ VÉ: @Model.Code</small></div><div class="e-ticket-qr"><div class="qr-pattern" aria-label="Mã QR vé"></div><span>Quét mã khi lên tàu</span><b>@Model.Code</b></div></article>
<div class="ticket-actions"><a class="button" asp-action="MyTickets">Vé của tôi</a><button class="button button-outline" onclick="window.print()">In vé</button><a class="back-link" asp-controller="Home" asp-action="Index">Về trang chủ</a></div></section>

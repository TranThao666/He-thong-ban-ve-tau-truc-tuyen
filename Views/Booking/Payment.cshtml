@model TrainTicket
@{
    ViewData["Title"] = "Thanh toán";
    var trip = Model.Trip!;
}
<section class="booking-progress"><span class="active">01 <b>Chọn chuyến</b></span><i></i><span class="active">02 <b>Chọn ghế</b></span><i></i><span class="active">03 <b>Hành khách</b></span><i></i><span class="active">04 <b>Thanh toán</b></span><i></i><span>05 <b>Hoàn tất</b></span></section>
<section class="section-block narrow-section"><div class="section-heading"><div><span class="eyebrow">HOÀN TẤT ĐẶT VÉ</span><h1>Thanh toán đơn hàng</h1><p class="muted">Chọn phương thức thanh toán để xác nhận vé.</p></div><span class="hold-countdown">15:00</span></div>
<div class="payment-layout"><form asp-action="Pay" method="post" class="panel payment-options">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><h3>Chọn phương thức thanh toán</h3><label class="payment-choice"><input type="radio" name="method" value="VNPay" checked/><span class="pay-logo">V</span><span><b>VNPay</b><small>Thanh toán an toàn qua VNPay</small></span><i></i></label><label class="payment-choice"><input type="radio" name="method" value="TheNganHang"/><span class="pay-logo">▤</span><span><b>Thẻ ngân hàng</b><small>ATM nội địa / Internet Banking</small></span><i></i></label><label class="payment-choice"><input type="radio" name="method" value="ViMoMo"/><span class="pay-logo pay-pink">M</span><span><b>Ví MoMo</b><small>Thanh toán bằng ví điện tử</small></span><i></i></label><button class="button button-block">Thanh toán @Model.Fare.ToString("N0") đ</button><p class="safe-note">🔒 Giao dịch của bạn được bảo mật.</p></form>
<aside class="panel summary-panel"><span class="eyebrow">CHI TIẾT ĐƠN HÀNG</span><div class="ticket-mini"><b>@trip.TrainCode</b><span>@trip.Route?.Name</span><small>@trip.Departure.ToString("dd/MM/yyyy HH:mm") → @trip.Arrival.ToString("dd/MM/yyyy HH:mm")</small></div><div class="summary-row"><span>Hành khách</span><b>@Model.PassengerName</b></div><div class="summary-row"><span>Số ghế</span><b>@Model.Seat?.Car?.Number - @Model.Seat?.Number</b></div><div class="summary-total"><span>Tổng cộng</span><strong>@Model.Fare.ToString("N0") đ</strong></div></aside></div></section>
